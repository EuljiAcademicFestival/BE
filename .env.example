DB_URL=jdbc:mysql://127.0.0.1:3306/eulji_festival?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=eulji_app
DB_PASSWORD=
# Base64-encoded random key: openssl rand -base64 32
JWT_SECRET=
# Optional: match the frontend origins for WebSocket connections.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Optional: shared REST top rankings snapshot TTL (ISO-8601 duration).
RANKING_TOP_CACHE_TTL=PT1S
